{
  "name": "ci-doctor",
  "version": "0.1.0",
  "description": "GitHub Action that finds deprecations that silently break CI and prints the exact fix.",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --legal-comments=eof --outfile=dist/index.js",
    "test": "node --test test/*.test.js",
    "check": "npm run build && git diff --exit-code dist/"
  },
  "author": "Joshua Almeida (fitzyracing1)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzyracing1/ci-doctor.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/fitzyracing1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github-actions",
    "ci",
    "deprecation",
    "lint",
    "workflow"
  ]
}
